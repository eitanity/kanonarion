# Packages in kanonarion's build that import a restricted package, one
# "<package> <import>" pair per line. Restricted means os/exec, plugin,
# syscall or unsafe. The list covers kanonarion's packages and its
# dependencies', keyed by package path without a version, across every release
# target; scripts/restricted-imports.sh fails on a pair missing from it and on
# an entry no target's build contains. Keep it sorted (LC_ALL=C sort -u); the
# script refuses an unsorted list. Regenerate the pairs with
# `bash scripts/restricted-imports.sh --print`. A new entry is reviewed with
# `kanonarion capability` (CONTRIBUTING.md, "Changing dependencies").

github.com/eitanity/kanonarion/internal/adapters/childproc os/exec
github.com/eitanity/kanonarion/internal/adapters/childproc syscall
github.com/eitanity/kanonarion/internal/adapters/factstore/sqlite os/exec
github.com/eitanity/kanonarion/internal/adapters/interrupt os/exec
github.com/eitanity/kanonarion/internal/adapters/vcs/gitexec os/exec
github.com/eitanity/kanonarion/internal/cli os/exec
github.com/eitanity/kanonarion/internal/cli syscall
github.com/eitanity/kanonarion/internal/local/adapters/importer/golist os/exec
github.com/eitanity/kanonarion/internal/local/adapters/probe/builder os/exec
github.com/eitanity/kanonarion/internal/local/localtest os/exec
github.com/eitanity/kanonarion/internal/staleness/adapters/golist os/exec
github.com/eitanity/kanonarion/internal/stdlib/adapters/gitlsremote os/exec
