# the FILTERED zero, and the control for sbom_list_json_empty: records exist and none matches this walk. The two zeros must not read alike — one says nothing was generated, the other says nothing matched — and the filtered one names the field it filtered on.
$ kanonarion sbom-list --json --walk 01ARZ3NDEKTSV4RRFFQ69G5FZZ
exit 0
