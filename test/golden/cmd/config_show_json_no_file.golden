# the same store as data: config_file.present says the file is absent, and settings[] says per key whether the value in force came from the file or from a built-in default.
$ kanonarion config show --json
exit 0
--- stdout ---
{
  "config_file": {
    "path": "$EMPTY_STORE/config.yaml",
    "present": false,
    "rejected": false
  },
  "version": "2",
  "preferences": {
    "json": false,
